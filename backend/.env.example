# Port backend (default 5000 kalau kosong).
# Flutter dan panduan testing memakai 6000, jadi disarankan 6000.
port=6000
NODE_ENV=development

# Database MySQL (Aiven Cloud / localhost)
# Kode membaca nama huruf kecil di bawah ini.
# SSL bersifat opsional (tidak aktif otomatis hanya karena host Aiven).
# Set db_ssl=true untuk memakai SSL dengan verifikasi sertifikat.
# Kalau perlu CA khusus, simpan file .pem dan isi PATH-nya di db_ca_cert.
# db_ca_cert=C:\DapurKita\backend\aiven-ca.pem
db_ssl=false
db_host=your-mysql-instance.aivencloud.com
db_port=12345
db_user=avnadmin
db_password=your_aiven_password
db_name=db_DapurKita

# Akun admin yang dibuat otomatis saat server pertama kali berjalan
# ADMIN_PASSWORD wajib diisi (tidak ada password bawaan).
ADMIN_NAME="Super Admin DapurKita"
ADMIN_EMAIL=admin@dapurkita.com
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat

# JWT (wajib diisi, tidak ada secret bawaan)
JWT_SECRET=ganti_dengan_secret_yang_panjang_dan_acak
JWT_EXPIRES_IN=14d

# Cloudinary (gambar produk, bukti pembayaran, foto profil)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Alamat aplikasi yang diizinkan mengakses API lewat browser (CORS).
# Mobile Flutter biasanya tidak memakai header Origin, jadi ini terutama untuk web.
CLIENT_URL=http://localhost:3000
